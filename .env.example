# Copy this file to `.env` if you need to change a value locally.
# Never commit `.env`. Nothing here is required to run the site.

# Which environment to build for: local, staging or production.
# Leave empty on your own machine. Cloudflare Pages is detected automatically.
SITE_ENV=

# The public Sentry address (DSN) for browser error reports. Empty means error
# tracking is switched off. Use the staging project's DSN, never production's.
PUBLIC_SENTRY_DSN=
