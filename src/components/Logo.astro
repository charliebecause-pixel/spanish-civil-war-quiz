---
// The site's mark: two axes in a circle with one point plotted on them.
// Decorative, so it is hidden from screen readers; the site name sits beside it.
---

<svg class="logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="10.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
  <path d="M12 3.5v17M3.5 12h17" fill="none" stroke="currentColor" stroke-width="1"></path>
  <circle cx="16" cy="8" r="2.4" fill="currentColor"></circle>
</svg>

<style>
  .logo {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-accent);
  }
</style>
