---
// The quiz: an intro, one question and two possible results. Every screen is
// in the HTML from the start, so all of its text comes from src/i18n. The
// script shows one screen at a time and never sends or stores the answer.
//
// How it looks and moves is described in docs/specs/visual-design.md.
import { t, type Locale, type MessageKey } from '../i18n';
import { DEATH_TOLL } from '../lib/death-tolls';
import { ANSWERS, VERDICT } from '../lib/quiz';
import Emblem from './Emblem.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const number = new Intl.NumberFormat(locale);
const facts: { value: number; label: MessageKey }[] = [
  { value: 1, label: 'home.fact.questions' },
  { value: 60, label: 'home.fact.seconds' },
  { value: 0, label: 'home.fact.signups' },
];
---

<div class="quiz" data-quiz>
  <section class="quiz__screen" data-quiz-screen="intro">
    <p class="overline">{t(locale, 'home.overline')}</p>
    <h1 class="quiz__title" tabindex="-1" data-quiz-heading>
      {t(locale, 'home.heading')}
    </h1>
    <p class="quiz__lead">{t(locale, 'home.lead')}</p>
    <ul class="quiz__facts">
      {facts.map((fact) => (
        <li>
          <span class="quiz__fact-value">{number.format(fact.value)}</span>
          <span class="quiz__fact-label">{t(locale, fact.label)}</span>
        </li>
      ))}
    </ul>
    <p class="quiz__actions">
      <!-- Disabled until the script is running, so it can never be a dead button. -->
      <button class="button quiz__start" type="button" data-quiz-action="start" disabled>
        {t(locale, 'quiz.start')}
      </button>
    </p>
    <p class="quiz__load-error">{t(locale, 'quiz.loadError')}</p>
    <p class="quiz__note">{t(locale, 'home.privacyNote')}</p>
  </section>

  <section class="quiz__screen" data-quiz-screen="question" hidden>
    <p class="overline">{t(locale, 'quiz.progress')}</p>
    <div class="quiz__progress" aria-hidden="true"></div>
    <h1 class="quiz__number" tabindex="-1" data-quiz-heading>
      {t(locale, 'quiz.question.number')}
    </h1>
    <p class="quiz__question" id="quiz-question">
      {t(locale, 'quiz.question.text')}
    </p>
    <div class="quiz__answers" role="group" aria-labelledby="quiz-question">
      {ANSWERS.map((answer) => (
        <button class="button" type="button" data-quiz-action="answer" data-quiz-answer={answer}>
          {t(locale, `quiz.answer.${answer}`)}
        </button>
      ))}
    </div>
    <p class="quiz__more">
      <a href={t(locale, 'quiz.moreInfo.url')} target="_blank" rel="noopener noreferrer">
        {t(locale, 'quiz.moreInfo.link')}{' '}
        <span class="quiz__more-where">{t(locale, 'quiz.moreInfo.where')}</span>
      </a>
    </p>
  </section>

  {ANSWERS.map((answer) => (
    <section
      class="quiz__screen"
      data-quiz-screen="result"
      data-quiz-verdict={VERDICT[answer]}
      hidden
    >
      <h1 class="quiz__verdict" tabindex="-1" data-quiz-heading>
        {t(locale, `quiz.verdict.${VERDICT[answer]}`)}
      </h1>
      <div class="quiz__emblem">
        <Emblem verdict={VERDICT[answer]} label={t(locale, `quiz.emblem.${VERDICT[answer]}`)} />
      </div>
      <div class="quiz__toll">
        {/* The final figure is in the HTML, so it is right without the script,
            with reduced motion, and for screen readers (which read the
            sentence below instead of the rolling digits). */}
        <p class="quiz__toll-number" aria-hidden="true">
          <span data-quiz-count={DEATH_TOLL[VERDICT[answer]]}>
            {number.format(DEATH_TOLL[VERDICT[answer]])}
          </span>
        </p>
        <p class="quiz__toll-label">
          <span class="visually-hidden">
            {t(locale, 'quiz.toll.over', { number: number.format(DEATH_TOLL[VERDICT[answer]]) })}
          </span>{' '}
          {t(locale, `quiz.toll.${VERDICT[answer]}.label`)}
        </p>
      </div>
      <p class="quiz__actions">
        <button class="button" type="button" data-quiz-action="restart">
          {t(locale, 'quiz.restart')}
        </button>
      </p>
      <p class="quiz__toll-note">{t(locale, `quiz.toll.${VERDICT[answer]}.note`)}</p>
    </section>
  ))}
</div>

<script>
  import '../scripts/quiz';
</script>

<style>
  .quiz {
    container-type: inline-size;
    text-align: center;
  }

  .quiz__screen {
    padding-top: clamp(0.5rem, 4vh, 3rem);
  }

  /* ---------- Intro: the straight face ---------- */

  .quiz__title {
    max-width: 20ch;
    margin: 0 auto 1rem;
    font-size: clamp(2.125rem, 8cqi, 3.75rem);
  }

  .quiz__lead {
    max-width: 34rem;
    margin: 0 auto 1.75rem;
    font-size: 1.1875rem;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .quiz__facts {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 6cqi, 3.5rem);
    max-width: 30rem;
    margin: 0 auto;
    padding: 1.125rem 0;
    list-style: none;
    border-block: 1px solid var(--color-rule);
  }

  .quiz__facts li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    min-width: 5rem;
  }

  .quiz__fact-value {
    font-size: 2.375rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--color-accent);
  }

  .quiz__fact-label {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .quiz__start {
    min-width: 14rem;
    min-height: 3.5rem;
    font-size: 1.25rem;
  }

  .quiz__note {
    max-width: 30rem;
    margin: 1.25rem auto 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* ---------- Question ---------- */

  /* "Step 1 of 1": a progress bar that is, accurately, complete. */
  .quiz__progress {
    width: min(100%, 14rem);
    height: 0.375rem;
    margin: 0 auto 1.75rem;
    border-radius: 1rem;
    background: var(--color-accent);
  }

  /* "Question #1" in big bold letters. */
  .quiz__number {
    font-size: clamp(2.5rem, 12cqi, 4.5rem);
    font-weight: 700;
  }

  .quiz__question {
    max-width: 38rem;
    margin: 0 auto 2rem;
    font-size: clamp(1.125rem, 3.6cqi, 1.375rem);
    text-wrap: pretty;
  }

  .quiz__answers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .quiz__answers .button {
    min-width: min(100%, 14rem);
    min-height: 3.75rem;
    font-size: 1.1875rem;
  }

  .quiz__actions {
    margin: clamp(1rem, 3vh, 2rem) 0 0;
  }

  /* Well below the answers, so nobody aiming for an answer hits it. */
  .quiz__more {
    margin: 2.5rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .quiz__more a {
    display: inline-block;
    padding: 0.5rem 0;
  }

  .quiz__more-where {
    color: var(--color-muted);
  }

  /* ---------- Result: the punchline ---------- */

  /*
   * Poster lettering that always fits: sized from the width of the quiz and
   * the height of the screen, whichever is tighter. The first size is for
   * browsers without those units.
   */
  .quiz__verdict {
    margin: 0;
    font-family: var(--font-poster);
    font-size: clamp(2.25rem, 11vw, 6rem);
    font-size: clamp(2.25rem, min(14cqi, 13svh), 7.5rem);
    font-weight: 800;
    /* Impact has one weight; do not let the browser smear a fake bold on it. */
    font-synthesis: none;
    line-height: 0.95;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
    text-shadow: 0.045em 0.045em 0 rgb(0 0 0 / 0.35);
  }

  /* A huge emblem, but never so big that the button below leaves the screen. */
  .quiz__emblem {
    width: min(62vw, 30vh);
    width: min(62cqi, 30svh);
    aspect-ratio: 1;
    margin: clamp(0.75rem, 2.5vh, 1.5rem) auto 0;
  }

  .quiz__emblem :global(.emblem) {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0.3rem 0.3rem 0 rgb(0 0 0 / 0.3));
  }

  /* The death toll: rolls up from zero when a result arrives (src/scripts/quiz.ts). */
  .quiz__toll {
    margin-top: clamp(0.5rem, 2vh, 1rem);
  }

  .quiz__toll-number {
    margin: 0;
    font-family: var(--font-poster);
    font-size: clamp(2rem, min(10cqi, 7svh), 4rem);
    font-synthesis: none;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    text-shadow: 0.05em 0.05em 0 rgb(0 0 0 / 0.35);
  }

  /* "60,000,000+": the plus says "over" without a word to translate. */
  .quiz__toll-number span::after {
    content: '+';
  }

  .quiz__toll-label {
    margin: 0.25rem 0 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .quiz__toll-note {
    max-width: 36rem;
    margin: 1.5rem auto 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ---------- Motion ---------- */

  /*
   * Only for visitors who have not asked their device to reduce motion, and
   * only when a screen has just been arrived at (not on first page load).
   * Nothing loops, and nothing lasts much more than a second.
   */
  @media (prefers-reduced-motion: no-preference) {
    .quiz__screen[data-quiz-arrived] {
      animation: quiz-arrive 220ms ease-out backwards;
    }

    .quiz__screen[data-quiz-arrived][data-quiz-screen='result'] {
      animation: quiz-shake 420ms cubic-bezier(0.36, 0.07, 0.19, 0.97) backwards;
    }

    .quiz__screen[data-quiz-arrived] .quiz__verdict {
      animation: quiz-slam 380ms cubic-bezier(0.2, 1.4, 0.4, 1) backwards;
    }

    .quiz__screen[data-quiz-arrived] .quiz__emblem {
      animation: quiz-emblem 560ms cubic-bezier(0.2, 1.3, 0.3, 1) 220ms backwards;
    }

    /* "A button pops up": after the verdict has had a moment to land. */
    .quiz__screen[data-quiz-arrived][data-quiz-screen='result'] .quiz__actions {
      animation: quiz-pop 320ms cubic-bezier(0.2, 1.5, 0.4, 1) 950ms backwards;
    }

    /* A keyboard user who tabs to the button early must see where focus is. */
    .quiz__screen[data-quiz-arrived][data-quiz-screen='result'] .quiz__actions:focus-within {
      animation: none;
    }
  }

  @keyframes quiz-arrive {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @keyframes quiz-shake {
    0%,
    100% {
      transform: translate(0, 0);
    }
    12% {
      transform: translate(-0.5rem, 0.25rem);
    }
    28% {
      transform: translate(0.4rem, -0.3rem);
    }
    44% {
      transform: translate(-0.3rem, 0.2rem);
    }
    60% {
      transform: translate(0.2rem, -0.15rem);
    }
    78% {
      transform: translate(-0.1rem, 0.05rem);
    }
  }

  @keyframes quiz-slam {
    from {
      opacity: 0;
      transform: scale(2.6);
    }
    55% {
      opacity: 1;
    }
  }

  @keyframes quiz-emblem {
    from {
      opacity: 0;
      transform: scale(0.15) rotate(-35deg);
    }
  }

  @keyframes quiz-pop {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  /* ---------- When the quiz cannot start ---------- */

  /*
   * If the script has not started after four seconds, say so and say what to
   * do. With JavaScript switched off, say it straight away. This is a delayed
   * message, not motion, so it applies to everyone.
   */
  .quiz__load-error {
    display: none;
    max-width: 30rem;
    margin: 1.5rem auto 0;
  }

  .quiz:not([data-quiz-ready]) .quiz__load-error {
    display: block;
    visibility: hidden;
    animation: quiz-show-load-error 0s linear 4s forwards;
  }

  @keyframes quiz-show-load-error {
    to {
      visibility: visible;
    }
  }

  @media (scripting: none) {
    .quiz:not([data-quiz-ready]) .quiz__load-error {
      visibility: visible;
      animation: none;
    }
  }
</style>
