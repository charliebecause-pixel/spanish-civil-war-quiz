---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { sentryDsn, siteConfig, siteEnv } from '../config';
import { DEFAULT_LOCALE, LOCALES, localePath, t, type Locale } from '../i18n';
import { OG_LOCALE, SOCIAL_IMAGE, socialImagePath } from '../lib/social-image';

interface Props {
  locale: Locale;
  /** The page's address without a language prefix, for example "/privacy/". */
  path: string;
  title: string;
  description: string;
  /** False for pages that exist in one language only (the 404 and test pages). */
  translated?: boolean;
  /** True for pages that want more room than a column of reading text. */
  wide?: boolean;
}

const { locale, path, title, description, translated = true, wide = false } = Astro.props;
const absolute = (target: Locale) => new URL(localePath(target, path), siteConfig.siteUrl).href;
const otherLocales = translated ? LOCALES.filter((entry) => entry !== locale) : [];
const siteName = t(locale, 'site.name');
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
// What link previews show (docs/decisions/0010-social-preview-image.md).
const socialImage = new URL(socialImagePath(locale), siteConfig.siteUrl).href;
const socialImageAlt = t(locale, 'social.imageAlt');
---

<!doctype html>
<html lang={locale} data-site-env={siteEnv} data-sentry-dsn={sentryDsn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {translated && (
      <>
        <link rel="canonical" href={absolute(locale)} />
        {LOCALES.map((entry) => (
          <link rel="alternate" hreflang={entry} href={absolute(entry)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LOCALE)} />
      </>
    )}
    {(siteEnv !== 'production' || !translated) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {translated && <meta property="og:url" content={absolute(locale)} />}
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {otherLocales.map((entry) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[entry]} />
    ))}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content={SOCIAL_IMAGE.type} />
    <meta property="og:image:width" content={String(SOCIAL_IMAGE.width)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(locale, 'nav.skip')}
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__name" href={localePath(locale, '/')}>
          <Logo />
          <span>{siteName}</span>
        </a>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <div class:list={['page', { 'page--wide': wide }]}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <nav class="site-footer__inner" aria-label={t(locale, 'footer.navLabel')}>
        <ul>
          <li>
            <a href={localePath(locale, '/about/')}>{t(locale, 'footer.about')}</a>
          </li>
          <li>
            <a href={localePath(locale, '/privacy/')}>{t(locale, 'footer.privacy')}</a>
          </li>
          <li>
            <a href={localePath(locale, '/terms/')}>{t(locale, 'footer.terms')}</a>
          </li>
          <li>
            <a href={localePath(locale, '/credits/')}>{t(locale, 'footer.credits')}</a>
          </li>
          {otherLocales.map((entry) => (
            <li>
              <a href={localePath(entry, path)} lang={entry} hreflang={entry}>
                {t(entry, 'footer.languageName')}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </footer>
    <script>
      import '../scripts/error-tracking';
    </script>
  </body>
</html>
