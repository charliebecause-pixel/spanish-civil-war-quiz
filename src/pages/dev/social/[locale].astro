---
// The link-preview picture, drawn as a page so it uses the site's own type,
// colours and logo. scripts/social-images.mjs photographs it into
// public/social/<locale>.jpg. Built for local, preview and staging only.
//
// It shows the straight face, never the result: no emblems, no verdict
// (docs/decisions/0010-social-preview-image.md). Every piece of text carries
// data-social-key, so the script can record which text went into the picture
// and a unit test can tell when the picture is out of date.
import '../../../styles/global.css';
import Logo from '../../../components/Logo.astro';
import { siteEnv } from '../../../config';
import { LOCALES, t, type Locale, type MessageKey } from '../../../i18n';
import { imagePath, imagesIn } from '../../../lib/quiz-images';

export function getStaticPaths() {
  return siteEnv === 'production'
    ? []
    : LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const number = new Intl.NumberFormat(locale);
const facts: { value: number; label: MessageKey }[] = [
  { value: 1, label: 'home.fact.questions' },
  { value: 60, label: 'home.fact.seconds' },
  { value: 0, label: 'home.fact.signups' },
];
const [republican] = imagesIn('question-a');
const [nationalist] = imagesIn('question-b');
const sides = [republican, nationalist].filter((image) => image !== undefined);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Social preview ({locale})</title>
  </head>
  <body>
    <div class="card" data-social-card>
      {sides.map((image, index) => (
        <div
          class:list={['card__poster', index === 0 ? 'card__poster--left' : 'card__poster--right']}
        >
          <img src={imagePath(image)} alt="" width={image.width} height={image.height} />
        </div>
      ))}
      <div class="card__body">
        <p class="card__brand">
          <Logo />
        </p>
        <p class="overline card__overline" data-social-key="home.overline">
          {t(locale, 'home.overline')}
        </p>
        <h1 class="card__title" data-social-key="home.heading">
          {t(locale, 'home.heading')}
        </h1>
        <ul class="card__facts">
          {facts.map((fact) => (
            <li>
              <span class="card__fact-value">{number.format(fact.value)}</span>
              <span class="card__fact-label" data-social-key={fact.label}>
                {t(locale, fact.label)}
              </span>
            </li>
          ))}
        </ul>
        <p class="card__answers">
          <span class="button" data-social-key="quiz.answer.republicans">
            {t(locale, 'quiz.answer.republicans')}
          </span>
          <span class="button" data-social-key="quiz.answer.nationalists">
            {t(locale, 'quiz.answer.nationalists')}
          </span>
        </p>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    min-height: 0;
    display: block;
  }

  .card {
    position: relative;
    display: grid;
    place-items: center;
    /* SOCIAL_IMAGE in src/lib/social-image.ts; the script checks they match. */
    width: 1200px;
    height: 630px;
    overflow: hidden;
    text-align: center;
    border-top: 0.5rem solid var(--color-accent);
  }

  /* The posters from behind the question, faint, one at each edge. */
  .card__poster {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 22rem;
    isolation: isolate;
    background: var(--color-background);
  }

  .card__poster--left {
    left: 0;
    mask-image: linear-gradient(to right, #000 55%, transparent);
  }

  .card__poster--right {
    right: 0;
    mask-image: linear-gradient(to left, #000 55%, transparent);
  }

  .card__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    opacity: 0.1;
    filter: blur(1px);
  }

  .card__body {
    position: relative;
    width: 52rem;
  }

  .card__brand {
    margin: 0 0 1.25rem;
  }

  .card__brand :global(.logo) {
    width: 3.5rem;
    height: 3.5rem;
  }

  .card__overline {
    font-size: 1.125rem;
  }

  .card__title {
    margin: 0 auto 1.75rem;
    font-size: 4.25rem;
    text-wrap: balance;
    line-height: 1.05;
  }

  .card__facts {
    display: flex;
    justify-content: center;
    gap: 3.5rem;
    max-width: 32rem;
    margin: 0 auto 2rem;
    padding: 1rem 0;
    list-style: none;
    border-block: 1px solid var(--color-rule);
  }

  .card__facts li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .card__fact-value {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--color-accent);
  }

  .card__fact-label {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .card__answers {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin: 0;
  }

  .card__answers .button {
    min-width: 15rem;
    min-height: 4rem;
    font-size: 1.375rem;
  }
</style>
